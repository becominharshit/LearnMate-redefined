rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Google accounts, or email accounts whose address has been verified. Anonymous and
    // unverified accounts can't read or write anything.
    function isVerifiedStudent() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'anonymous' &&
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedStudent() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedStudent() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidQuestionBankRecord(data, questionId) {
      return data.keys().hasAll(['id', 'exam', 'year', 'subject', 'chapter', 'topic', 'difficulty', 'questionType', 'status']) &&
             data.id is string && data.id == questionId && data.id.size() <= 160 &&
             data.exam in ['JEE_MAIN', 'JEE_ADVANCED'] &&
             data.year is int && data.year >= 1995 && data.year <= 2030 &&
             data.subject in ['PHYSICS', 'CHEMISTRY', 'MATHEMATICS'] &&
             data.chapter is string && data.chapter.size() > 0 && data.chapter.size() <= 160 &&
             data.topic is string && data.topic.size() > 0 && data.topic.size() <= 160 &&
             data.difficulty in ['EASY', 'MEDIUM', 'HARD'] &&
             data.questionType in ['MCQ_SINGLE', 'MCQ_MULTI', 'NUMERICAL', 'INTEGER', 'DECIMAL', 'ASSERTION_REASON'] &&
             data.status in ['APPROVED', 'PENDING_REVIEW', 'REJECTED', 'FAILED_VALIDATION'];
    }

    function isValidQuestionIdMapping(data) {
      return data.keys().hasAll(['mappingKey', 'sourceId', 'externalId', 'learnMateQuestionId', 'importedAt']) &&
             data.mappingKey is string && data.mappingKey.size() <= 240 &&
             data.sourceId is string && data.sourceId.size() <= 80 &&
             data.externalId is string && data.externalId.size() <= 160 &&
             data.learnMateQuestionId is string && data.learnMateQuestionId.size() <= 160 &&
             data.importedAt is string && data.importedAt.size() <= 64;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'updatedAt', 'email', 'displayName', 'photoURL', 'activeDocumentId', 'profileJson']) &&
             data.uid is string && data.uid == userId &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 320)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 160)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('activeDocumentId' in data) || (data.activeDocumentId is string && data.activeDocumentId.size() <= 160)) &&
             (!('profileJson' in data) || (data.profileJson is string && data.profileJson.size() <= 20000));
    }

    function isValidStudyDocument(data, userId, docId) {
      return data.keys().hasAll(['id', 'uid', 'title', 'sourceType', 'pageCount', 'pagesJson', 'topicsJson', 'overview', 'createdAt', 'lastStudiedAt']) &&
             data.keys().hasOnly(['id', 'uid', 'title', 'sourceType', 'pageCount', 'pagesJson', 'topicsJson', 'overview', 'createdAt', 'lastStudiedAt', 'youtubeUrl', 'videoId']) &&
             data.uid is string && data.uid == userId &&
             data.id is string && data.id == docId && data.id.size() <= 160 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.sourceType in ['pdf', 'text', 'youtube', 'scanned_notes', 'voice_note', 'course'] &&
             (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 1024)) &&
             (!('videoId' in data) || (data.videoId is string && data.videoId.size() <= 64)) &&
             data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 120 &&
             data.pagesJson is string && data.pagesJson.size() <= 700000 &&
             data.topicsJson is string && data.topicsJson.size() <= 150000 &&
             data.overview is string && data.overview.size() <= 10000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.lastStudiedAt is string && data.lastStudiedAt.size() <= 64;
    }

    function isValidQuizAttempt(data, userId, attemptId) {
      return data.keys().hasAll(['id', 'uid', 'documentId', 'documentTitle', 'mode', 'score', 'totalQuestions', 'percentage', 'attemptJson', 'completedAt']) &&
             data.keys().hasOnly(['id', 'uid', 'documentId', 'documentTitle', 'mode', 'score', 'totalQuestions', 'percentage', 'attemptJson', 'completedAt']) &&
             data.uid is string && data.uid == userId &&
             data.id is string && data.id == attemptId && data.id.size() <= 160 &&
             data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 160 &&
             data.documentTitle is string && data.documentTitle.size() <= 300 &&
             data.mode in ['diagnostic', 'adaptive', 'jee_simulator'] &&
             data.score is int && data.score >= 0 && data.score <= 300 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
             data.percentage is int && data.percentage >= 0 && data.percentage <= 100 &&
             data.attemptJson is string && data.attemptJson.size() <= 500000 &&
             data.completedAt is string && data.completedAt.size() <= 64;
    }

    function isValidStudyState(data, userId, docId) {
      return data.keys().hasAll(['documentId', 'uid', 'updatedAt']) &&
             data.keys().hasOnly([
               'documentId', 'uid', 'updatedAt',
               'tutorMessagesJson', 'mistakesJson', 'revisionPlanJson',
               'cachedQuizJson', 'quickReviseJson',
               'conceptAttemptsJson', 'conceptMasteryJson', 'creativeAssetsJson'
             ]) &&
             data.uid is string && data.uid == userId &&
             data.documentId is string && data.documentId == docId && data.documentId.size() <= 160 &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('tutorMessagesJson' in data) || (data.tutorMessagesJson is string && data.tutorMessagesJson.size() <= 150000)) &&
             (!('mistakesJson' in data) || (data.mistakesJson is string && data.mistakesJson.size() <= 100000)) &&
             (!('revisionPlanJson' in data) || (data.revisionPlanJson is string && data.revisionPlanJson.size() <= 100000)) &&
             (!('cachedQuizJson' in data) || (data.cachedQuizJson is string && data.cachedQuizJson.size() <= 100000)) &&
             (!('quickReviseJson' in data) || (data.quickReviseJson is string && data.quickReviseJson.size() <= 150000)) &&
             (!('conceptAttemptsJson' in data) || (data.conceptAttemptsJson is string && data.conceptAttemptsJson.size() <= 120000)) &&
             (!('conceptMasteryJson' in data) || (data.conceptMasteryJson is string && data.conceptMasteryJson.size() <= 80000)) &&
             (!('creativeAssetsJson' in data) || (data.creativeAssetsJson is string && data.creativeAssetsJson.size() <= 150000));
    }

    // Reports a student files about an AI answer; reviewed by the LearnMate team in the console.
    function isValidAiReport(data, userId, reportId) {
      return data.keys().hasOnly(['id', 'uid', 'kind', 'reason', 'note', 'excerpt', 'documentId', 'createdAt']) &&
             data.keys().hasAll(['id', 'uid', 'kind', 'reason', 'excerpt', 'createdAt']) &&
             data.uid is string && data.uid == userId &&
             data.id is string && data.id == reportId && data.id.size() <= 160 &&
             data.kind in ['tutor_answer', 'practice_question', 'diagram', 'animated_explanation', 'concept_check'] &&
             data.reason in ['wrong', 'unclear', 'inappropriate', 'other'] &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             data.excerpt is string && data.excerpt.size() <= 2000 &&
             (!('documentId' in data) || (data.documentId is string && data.documentId.size() <= 160)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // ===============================================================
    // User Scoped Collections: every student can reach only their own data.
    // Anything not matched below is denied.
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /documents/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidStudyDocument(request.resource.data, userId, docId);
        allow delete: if isOwner(userId);
      }

      match /attempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidQuizAttempt(request.resource.data, userId, attemptId);
        allow delete: if isOwner(userId);
      }

      match /studyState/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidStudyState(request.resource.data, userId, docId);
        allow delete: if isOwner(userId);
      }

      match /reports/{reportId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAiReport(request.resource.data, userId, reportId);
        allow delete: if isOwner(userId);
      }

      // Commercial entitlements are read-only for the owning student; writes require server Admin SDK / signed billing webhook.
      match /entitlements/{entitlementId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Closed-loop learning intelligence records (diagnosis, seenQuestionIds, consent settings).
      match /learningIntelligence/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
                                 request.resource.data.keys().hasAll(['uid', 'updatedAt']) &&
                                 request.resource.data.uid == userId &&
                                 request.resource.data.updatedAt is string &&
                                 request.resource.data.updatedAt.size() <= 64;
        allow delete: if isOwner(userId);
      }
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    match /shared_snapshots/{shareId} {
      allow get: if resource != null &&
                    resource.data.revoked != true &&
                    (!('expiresAtMs' in resource.data) || request.time.toMillis() < resource.data.expiresAtMs);
      allow list: if false;
      allow create: if isVerifiedStudent() &&
                       request.resource.data.keys().hasAll(['shareId', 'ownerUid', 'kind', 'createdAt']) &&
                       request.resource.data.shareId == shareId &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isVerifiedStudent() &&
                               resource != null &&
                               resource.data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // Global Unified Question Bank & Dataset Ingestion Collections
    // Students can read approved questions; only admins can import/modify.
    // ===============================================================
    match /question_bank/{questionId} {
      allow read: if isAdmin() || (isVerifiedStudent() && resource.data.status == 'APPROVED');
      allow create, update: if isAdmin() && isValidQuestionBankRecord(request.resource.data, questionId);
      allow delete: if isAdmin();
    }

    match /question_id_mappings/{mappingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidQuestionIdMapping(request.resource.data);
      allow delete: if isAdmin();
    }

    match /ingestion_jobs/{jobId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
