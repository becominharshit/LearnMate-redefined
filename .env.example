# Copy this file to .env and fill in the values. Never commit .env.

# GEMINI_API_KEY: Required. Powers the AI tutor, quizzes, OCR, transcription and voice tutor.
# Get one at https://aistudio.google.com/api-keys (use a paid-tier key in production:
# free-tier prompts may be used to improve Google's products).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where the app is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional. YouTube Data API v3 key for video recommendations in Explore Further.
YOUTUBE_API_KEY=""

# ANTHROPIC_API_KEY: Optional. Only used by the AI 3D model creator.
ANTHROPIC_API_KEY=""

# ADMIN_TOKEN: Required in production to read /api/usage, /api/capabilities and /api/vertex/*
# (send it in the "x-admin-token" header). Without it those endpoints return 404 in production.
ADMIN_TOKEN=""

# GOOGLE_GENAI_USE_VERTEXAI: Optional ("auto" | "true" | "false"). Vertex AI uses Application
# Default Credentials (ADC); no service-account JSON key files are used.
GOOGLE_GENAI_USE_VERTEXAI="false"

# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION: Only needed when Vertex AI is enabled.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
