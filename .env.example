# Copy this file to .env and fill in the values. Never commit .env.
# You need at least one AI key: ANTHROPIC_API_KEY (recommended) or GEMINI_API_KEY.

# ANTHROPIC_API_KEY: Powers the AI tutor, quizzes, notes scanning (OCR), revision tools,
# voice answers and the 3D model creator. Get one at https://platform.claude.com (starts with "sk-ant-").
ANTHROPIC_API_KEY=""

# Optional Claude settings.
# ANTHROPIC_MODEL_SMART: tutoring, quiz writing and notes scanning (default: claude-sonnet-5-5).
# ANTHROPIC_MODEL_FAST: flashcards, mistake analysis and other high-volume tasks (default: claude-haiku-5-5).
ANTHROPIC_MODEL_SMART=""
ANTHROPIC_MODEL_FAST=""
# ANTHROPIC_BASE_URL: Only for a proxy or a local mock server. Leave empty to use https://api.anthropic.com.
ANTHROPIC_BASE_URL=""

# AI_PROVIDER: "auto" (default) uses Claude whenever ANTHROPIC_API_KEY is set and falls back to
# Gemini if that is also configured. "gemini" prefers Gemini when both keys are present.
AI_PROVIDER="auto"

# GEMINI_API_KEY: Optional when ANTHROPIC_API_KEY is set. Also enables Gemini Live voice and
# Gemini image generation. Get one at https://aistudio.google.com/api-keys (use a paid-tier key
# in production: free-tier prompts may be used to improve Google's products).
GEMINI_API_KEY=""

# HIGGSFIELD_API_KEY: Optional. Generates images and short videos in the Create section.
# Paste the complete key from https://open.higgsfield.ai/api-keys in "KEY_ID:KEY_SECRET" form.
# If your console showed the ID and secret separately, put the ID here and the secret below.
# API usage is billed from your prepaid Higgsfield API balance (not subscription credits).
HIGGSFIELD_API_KEY=""
HIGGSFIELD_API_SECRET=""

# Optional Higgsfield model overrides (see https://docs.higgsfield.ai for model ids).
# HIGGSFIELD_DIAGRAM_MODEL="ideogram/v4.0"
# HIGGSFIELD_ILLUSTRATION_MODEL="recraft/v4.1/text-to-image"
# HIGGSFIELD_PHOTO_MODEL="higgsfield-ai/soul/v2/standard"
# HIGGSFIELD_VIDEO_MODEL="kling-video/v3.0/std/text-to-video"
# HIGGSFIELD_IMAGE_TO_VIDEO_MODEL="kling-video/v2.5-turbo/pro/image-to-video"
# HIGGSFIELD_BASE_URL: Only for a proxy or a local mock server. Leave unset to use https://api.higgsfield.ai.

# APP_URL: The public URL where the app is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional. YouTube Data API v3 key for video recommendations in Explore Further.
YOUTUBE_API_KEY=""

# ADMIN_TOKEN: Required in production to read /api/usage, /api/capabilities and /api/vertex/*
# (send it in the "x-admin-token" header). Without it those endpoints return 404 in production.
ADMIN_TOKEN=""

# GOOGLE_GENAI_USE_VERTEXAI: Optional ("auto" | "true" | "false"). Vertex AI uses Application
# Default Credentials (ADC); no service-account JSON key files are used.
GOOGLE_GENAI_USE_VERTEXAI="false"

# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION: Only needed when Vertex AI is enabled.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
