# Copy this file to .env and fill in the values. Never commit .env.
# Required: ANTHROPIC_API_KEY, plus the six VITE_FIREBASE_* settings for sign-in.

# ---------------------------------------------------------------------------
# Claude (required) — powers the tutor, quizzes, notes scanning, revision and Create.
# ---------------------------------------------------------------------------
# Get a key at https://platform.claude.com (starts with "sk-ant-"). Prepaid credits work;
# set a monthly budget alert in the Anthropic console before sharing the app.
ANTHROPIC_API_KEY=""

# Optional Claude settings.
# ANTHROPIC_MODEL_SMART: tutoring, quiz writing and notes scanning (default: claude-sonnet-5-5).
# ANTHROPIC_MODEL_FAST: flashcards, mistake analysis and other high-volume tasks (default: claude-haiku-5-5).
ANTHROPIC_MODEL_SMART=""
ANTHROPIC_MODEL_FAST=""
# ANTHROPIC_BASE_URL: Only for a proxy or a local mock server. Leave empty to use https://api.anthropic.com.
ANTHROPIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Firebase sign-in and database (required before the app can be used)
# ---------------------------------------------------------------------------
# Firebase console → Project settings (gear) → General → Your apps → Web (</>) → firebaseConfig.
# These web values are public, not secrets. Use a separate project for development and production.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Local development without a Firebase project: set this to "true", set
# VITE_FIREBASE_PROJECT_ID="demo-learnmate", then run `npm run emulators` in another terminal.
VITE_FIREBASE_USE_EMULATOR="false"

# ---------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------
# APP_URL: the public URL where the app is hosted, e.g. https://learnmate.example.com.
APP_URL=""

# ALLOWED_ORIGINS: extra browser origins that may call the API (comma-separated), if any.
ALLOWED_ORIGINS=""

# AI_REQUESTS_PER_MINUTE: short burst limit per student (default: 12).
AI_REQUESTS_PER_MINUTE="12"

# Daily allowances per student, reset at midnight India time. Leave a value unset to use
# the default. Set a limit to 0 to switch that feature off for everyone.
#   tutor=40 (AI tutor and voice questions), practice=6 (quiz sets), revise=20,
#   upload=15 (PDFs, scans, transcripts), create=10.
# DAILY_LIMIT_TUTOR="40"
# DAILY_LIMIT_PRACTICE="6"
# DAILY_LIMIT_REVISE="20"
# DAILY_LIMIT_UPLOAD="15"
# DAILY_LIMIT_CREATE="10"

# ADMIN_TOKEN: Required in production to read /api/usage, /api/capabilities and /api/vertex/*
# (send it in the "x-admin-token" header). Without it those endpoints return 404 in production.
ADMIN_TOKEN=""

# VITE_SUPPORT_EMAIL: shown on the AI & safety page and in report replies.
VITE_SUPPORT_EMAIL=""

# YOUTUBE_API_KEY: Optional. YouTube Data API v3 key for video recommendations in Explore Further.
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------
# Higgsfield (paused — 18+ accounts only, in a later phase)
# ---------------------------------------------------------------------------
# Higgsfield's API terms require every end user to be 18 or older, so the server ignores these
# keys until age checks and parental approval exist. Claude diagrams and animated explanations
# work for every student without these.
# HIGGSFIELD_API_KEY=""
# HIGGSFIELD_API_SECRET=""
# Optional model overrides (see https://docs.higgsfield.ai for model ids).
# HIGGSFIELD_DIAGRAM_MODEL="ideogram/v4.0"
# HIGGSFIELD_ILLUSTRATION_MODEL="recraft/v4.1/text-to-image"
# HIGGSFIELD_PHOTO_MODEL="higgsfield-ai/soul/v2/standard"
# HIGGSFIELD_VIDEO_MODEL="kling-video/v3.0/std/text-to-video"
# HIGGSFIELD_IMAGE_TO_VIDEO_MODEL="kling-video/v2.5-turbo/pro/image-to-video"
# HIGGSFIELD_BASE_URL=""
